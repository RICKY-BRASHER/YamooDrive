# Copy this file to .env.production on the VM. Never commit the completed file.
APP_NAME="Yamoo Drive"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_DOMAIN=yamoo-example.duckdns.org
APP_URL=https://yamoo-example.duckdns.org
FRONTEND_URL=https://yamoo-example.duckdns.org
FRONTEND_URLS=https://yamoo-example.duckdns.org

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=yamoo_drive
DB_USERNAME=yamoo
DB_PASSWORD=replace-with-a-long-random-password

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=replace-with-smtp-username
MAIL_PASSWORD=replace-with-smtp-password
MAIL_EHLO_DOMAIN=yamoo-example.duckdns.org
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="Yamoo Drive"

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=yamoo-production
REVERB_APP_KEY=replace-with-a-random-public-key
REVERB_APP_SECRET=replace-with-a-long-random-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
